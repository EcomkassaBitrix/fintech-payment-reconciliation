{
  "tests": [
    {
      "name": "Tick without token",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "tick"
      },
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "Public metrika",
      "method": "GET",
      "path": "/?public=1",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Public banners",
      "method": "GET",
      "path": "/?banners=1",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Без входа доступ закрыт",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Ручной запуск без входа закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "run_now",
        "source": "ofd",
        "requester_user_id": 1
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    }
  ]
}