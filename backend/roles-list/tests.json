    {"name": "Удаление роли с поддельной сессией закрыто", "method": "DELETE", "path": "/", "headers": {"X-Session-Id": "fake-session-token"}, "body": {"role_id": 1}, "expectedStatus": 401, "expectedBody": {"error_code": "session_required"}, "bodyMatcher": "partial"}
